# Optional. Admin backend HTTP origin (without /api) for deployments that do not
# use the dev-server port resolution in vite.config.ts.
# Leave unset locally: the origin resolves through
# E2E_ADMIN_API_ORIGIN -> E2E_ADMIN_API_PORT -> TEZT_PORT_BASE+2 -> http://localhost:5000
# VITE_API_URL=https://admin-api.example.com
